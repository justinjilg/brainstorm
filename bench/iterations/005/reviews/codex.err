    56	export const beginTransactionTool = defineTool({
    57	  name: "begin_transaction",
    58	  description:
    59	    "Start an atomic transaction for multi-file edits. All file writes between begin and commit/rollback are tracked. On rollback, all changes revert. Use for coordinated multi-file changes where partial application would break the build.",
    60	  permission: "auto",
    61	  inputSchema: z.object({
    62	    description: z.string().optional().describe("What this transaction is for"),
    63	  }),
    64	  async execute({ description }) {
    65	    const s = txFor(getSessionId());
    66	    if (s.active) {
    67	      return { error: "Transaction already active. Commit or rollback first." };
    68	    }
    69	    s.active = true;
    70	    s.files = [];
    71	    return {
    72	      success: true,
    73	      message: `Transaction started.${description ? ` Purpose: ${description}` : ""} All file writes are now tracked. Use commit_transaction to finalize or rollback_transaction to revert.`,
    74	    };
    75	  },
    76	});
    77	
    78	export const commitTransactionTool = defineTool({
    79	  name: "commit_transaction",
    80	  description:
    81	    "Finalize a transaction. All file writes since begin_transaction are kept. Returns the list of files modified.",
    82	  permission: "auto",
    83	  inputSchema: z.object({}),
    84	  async execute() {
    85	    const s = txFor(getSessionId());
    86	    if (!s.active) {
    87	      return { error: "No active transaction to commit." };
    88	    }
    89	    const files = [...s.files];
    90	    s.active = false;
    91	    s.files = [];
    92	    return {
    93	      success: true,
    94	      filesCommitted: files,
    95	      count: files.length,
    96	    };
    97	  },
    98	});
