    15	 *
    16	 * Per-session: a single module-global `transactionActive` flag meant two
    17	 * concurrent runs corrupted each other's transactions (one committing while
    18	 * the other tracked files). Keyed by the current session id instead.
    19	 */
    20	
    21	interface TxState {
    22	  active: boolean;
    23	  files: string[];
    24	}
    25	const MAX_TRACKED_SESSIONS = 256;
    26	const txStates = new Map<string, TxState>();
    27	
    28	function txFor(sessionId: string): TxState {
    29	  let s = txStates.get(sessionId);
    30	  if (!s) {
    31	    if (txStates.size >= MAX_TRACKED_SESSIONS) {
    32	      const oldest = txStates.keys().next().value;
    33	      if (oldest !== undefined) txStates.delete(oldest);
    34	    }
    35	    s = { active: false, files: [] };
    36	    txStates.set(sessionId, s);
    37	  }
    38	  return s;
    39	}
    40	
    41	export function isTransactionActive(): boolean {
    42	  return txFor(getSessionId()).active;
    43	}
    44	
    45	export function getTransactionFiles(): string[] {
    46	  return [...txFor(getSessionId()).files];
    47	}
    48	
    49	export function recordTransactionFile(path: string): void {
    50	  const s = txFor(getSessionId());
    51	  if (s.active && !s.files.includes(path)) {
    52	    s.files.push(path);
    53	  }
    54	}
