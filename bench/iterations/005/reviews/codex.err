    43	/**
    44	 * Register the TUI task-event handler for a session. Defaults to the current
    45	 * session scope; pass an explicit id from outside a session context.
    46	 */
    47	export function setTaskEventHandler(
    48	  handler: TaskEventHandler | null,
    49	  sessionId: string = getSessionId(),
    50	): void {
    51	  storeFor(sessionId).onTaskEvent = handler;
    52	}
    53	
    54	/** Clear a session's tasks and release its store. */
    55	export function clearTasks(sessionId: string = getSessionId()): void {
    56	  sessionStores.delete(sessionId);
    57	}
