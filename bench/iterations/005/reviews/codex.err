    24	// Cardinality bound so a missed clearTasks() (crash, forgotten teardown) can't
    25	// leak stores forever; oldest-inserted is evicted (mirrors the iter-003
    26	// quarantine bound).
    27	const MAX_TRACKED_SESSIONS = 256;
    28	const sessionStores = new Map<string, SessionTaskStore>();
    29	
    30	function storeFor(sessionId: string): SessionTaskStore {
    31	  let store = sessionStores.get(sessionId);
    32	  if (!store) {
    33	    if (sessionStores.size >= MAX_TRACKED_SESSIONS) {
    34	      const oldest = sessionStores.keys().next().value;
    35	      if (oldest !== undefined) sessionStores.delete(oldest);
    36	    }
    37	    store = { tasks: new Map(), nextId: 1, onTaskEvent: null };
    38	    sessionStores.set(sessionId, store);
    39	  }
    40	  return store;
    41	}
