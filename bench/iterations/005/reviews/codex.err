   100	export const rollbackTransactionTool = defineTool({
   101	  name: "rollback_transaction",
   102	  description:
   103	    "Rollback a transaction. All file writes since begin_transaction are reverted using checkpoint snapshots. Returns the list of files reverted.",
   104	  permission: "confirm",
   105	  inputSchema: z.object({
   106	    reason: z.string().optional().describe("Why the rollback is needed"),
   107	  }),
   108	  async execute({ reason }) {
   109	    const s = txFor(getSessionId());
   110	    if (!s.active) {
   111	      return { error: "No active transaction to rollback." };
   112	    }
   113	
   114	    const { getCheckpointManager } = await import("../checkpoint.js");
   115	    const cp = getCheckpointManager();
   116	    const reverted: string[] = [];
   117	
   118	    const failed: Array<{ file: string; error: string }> = [];
   119	
   120	    // Order files by dependencies: dependents first, then dependencies
   121	    const ordered = orderByDependencies(s.files);
   122	
   123	    if (cp) {
   124	      // Revert dependents before dependencies to maintain consistency
   125	      for (const file of ordered) {
   126	        try {
   127	          const result = cp.revertLast(file);
   128	          if (result) {
   129	            reverted.push(result);
   130	          } else {
   131	            failed.push({ file, error: "No checkpoint snapshot available" });
   132	          }
   133	        } catch (e: any) {
   134	          failed.push({ file, error: e.message ?? String(e) });
   135	        }
   136	      }
   137	    } else {
   138	      // No checkpoint manager — all files fail
   139	      for (const file of s.files) {
   140	        failed.push({ file, error: "CheckpointManager not initialized" });
   141	      }
