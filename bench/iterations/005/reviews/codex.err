    59	export const taskCreateTool = defineTool({
    60	  name: "task_create",
    61	  description:
    62	    "Create a task to track progress on multi-step work. Use this to show the user what you are working on.",
    63	  permission: "auto",
    64	  inputSchema: z.object({
    65	    description: z
    66	      .string()
    67	      .describe("Short description of the task (1 sentence)"),
    68	  }),
    69	  async execute({ description }) {
    70	    const store = storeFor(getSessionId());
    71	    const id = `task-${store.nextId++}`;
    72	    const now = Date.now();
    73	    const task: AgentTask = {
    74	      id,
    75	      description,
    76	      status: "in_progress",
    77	      createdAt: now,
    78	      updatedAt: now,
    79	    };
    80	    store.tasks.set(id, task);
    81	    store.onTaskEvent?.("task-created", task);
    82	    return { id, status: task.status };
    83	  },
    84	});
    85	
    86	export const taskUpdateTool = defineTool({
    87	  name: "task_update",
    88	  description:
    89	    "Update the status of an existing task. Mark tasks as completed when done, or failed if they cannot be completed.",
    90	  permission: "auto",
    91	  inputSchema: z.object({
    92	    id: z.string().describe("Task ID returned by task_create"),
    93	    status: z
    94	      .enum(["pending", "in_progress", "completed", "failed"])
    95	      .describe("New status"),
    96	  }),
    97	  async execute({ id, status }) {
    98	    const store = storeFor(getSessionId());
    99	    const task = store.tasks.get(id);
   100	    if (!task) return { error: `Task ${id} not found` };
   101	    task.status = status as TaskStatus;
   102	    task.updatedAt = Date.now();
   103	    store.onTaskEvent?.("task-updated", task);
   104	    return { id, status: task.status };
   105	  },
   106	});
