    46	    // full-rate billable count.
    47	    const cachedTokens = Math.min(params.cachedTokens ?? 0, params.inputTokens);
    48	    const fullRateInputTokens = params.inputTokens - cachedTokens;
    49	
    50	    const cost =
    51	      (fullRateInputTokens / 1_000_000) * params.pricing.inputPer1MTokens +
    52	      (cachedTokens / 1_000_000) * cachedRate +
    53	      (params.outputTokens / 1_000_000) * params.pricing.outputPer1MTokens;
