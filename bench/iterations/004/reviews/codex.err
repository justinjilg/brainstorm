   120	 * Smart phase selection — BrainstormLLM v2 kill gate findings.
   121	 *
   122	 * Kill gate evaluation (2,203 examples, 233 Claude Code sessions):
   123	 * - spec: 0.95 F1 (highly predictable from request text)
   124	 * - implementation: 0.84 F1 (highly predictable)
   125	 * - architecture/refactor/report: always skippable (33% free savings)
   126	 * - verify/review/deploy: depend on session state (future v2.1)
   127	 *
   128	 * Hybrid approach:
   129	 * 1. Static rules: skip architecture, refactor, report (never needed in practice)
   130	 * 2. Request classifier: predict spec + implementation from text
   131	 * 3. Always include: verify (if build command), review (if implementation ran)
   132	 */
   133	function selectSmartPhases(
   134	  request: string,
   135	  options: PipelineOptions,
   136	): PipelinePhase[] {
   137	  const phases: PipelinePhase[] = [];
   138	  const lower = request.toLowerCase();
   139	
   140	  // Spec phase: high F1 (0.95) — include for features, skip for fixes
   141	  const isFeature = /\b(add|create|build|implement|new|design)\b/.test(lower);
   142	  const isFix = /\b(fix|bug|error|broken|crash|patch)\b/.test(lower);
   143	  const isRefactor = /\b(refactor|clean|reorganize|simplify)\b/.test(lower);
   144	  const isDoc = /\b(doc|readme|changelog|comment|describe)\b/.test(lower);
   145	
   146	  if (isFeature || isDoc) phases.push("spec");
   147	  // architecture: ALWAYS SKIP (kill gate finding: 0% usage in real sessions)
   148	  // implementation: high F1 (0.84) — include for code tasks
   149	  if (!isDoc) phases.push("implementation");
   150	  // review: include after implementation (session-state dependent, default on)
   151	  if (!isDoc && !isFix) phases.push("review");
   152	  // verify: include if build command exists
   153	  if (options.buildCommand) phases.push("verify");
   154	  // refactor: ALWAYS SKIP (kill gate finding: never needed standalone)
   155	  // deploy: only if explicitly requested
   156	  if (options.deploy) phases.push("deploy");
   157	  // document: include for features and doc tasks
   158	  if (isFeature || isDoc) phases.push("document");
   159	  // report: ALWAYS SKIP (kill gate finding: never needed in practice)
   160	
   161	  return phases.length > 0 ? phases : ["spec", "implementation", "verify"];
   162	}
