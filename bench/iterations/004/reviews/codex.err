   871	  private async handleChatStream(
   872	    req: IncomingMessage,
   873	    res: ServerResponse,
   874	  ): Promise<void> {
   875	    const body = await this.readBody<ChatRequest>(req);
   876	    if (!body.message) {
   877	      return this.errorResponse(res, 400, "Missing 'message' field");
   878	    }
   879	
   880	    res.writeHead(200, {
   881	      "Content-Type": "text/event-stream",
   882	      "Cache-Control": "no-cache",
   883	      Connection: "keep-alive",
   884	      ...this.corsHeaders(req),
   885	    });
   886	
   887	    const {
