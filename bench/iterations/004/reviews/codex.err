   228	  // Skip phases before resumeFrom
   229	  let skipping = !!options.resumeFrom;
   230	  // Terminal-state guard: the loop can break early (budget pause) and also
   231	  // fall through to the post-loop terminal. Exactly one terminal event and
   232	  // exactly one recorder.finalize() must happen — this flag enforces it.
   233	  let terminated = false;
   234	
   235	  // Helper: yield event AND record to trajectory
   236	  function record(event: PipelineEvent) {
   237	    recorder.recordEvent(event);
   238	    return event;
   239	  }
   240	
   241	  yield record({ type: "pipeline-started", request, phases });
   242	
   243	  for (const phase of phases) {
   244	    if (skipping) {
   245	      if (phase === options.resumeFrom) skipping = false;
   246	      else continue;
   247	    }
   248	
   249	    // Budget guard — pause is a terminal state: emit once, finalize once,
   250	    // and DON'T fall through to the post-loop completed/failed terminal.
   251	    if (options.budget && totalCost >= options.budget) {
   252	      yield record({
   253	        type: "pipeline-paused",
   254	        phase,
   255	        reason: `Budget exhausted: $${totalCost.toFixed(2)}`,
   256	      });
   257	      recorder.finalize();
   258	      terminated = true;
   259	      break;
   260	    }
   261	
   262	    // Skip deploy if not requested
   263	    if (phase === "deploy" && !options.deploy) continue;
   264	
   265	    const config = PHASE_CONFIG[phase];
   266	    const startTime = Date.now();
   267	
   268	    yield record({ type: "phase-started", phase, agentId: config.agentId });
   269	
   270	    if (options.dryRun) {
   271	      const result: PhaseResult = {
   272	        phase,
   273	        agentId: config.agentId,
   274	        output: `[Dry run] Would dispatch ${config.agentId} (${config.subagentType})`,
   275	        cost: 0,
   276	        toolCalls: [],
