   208	  // resumeFrom with a phase that isn't in the selected list silently
   209	  // skipped every phase in the loop below and yielded pipeline-completed
   210	  // with zero work done. That looks like success to the caller. Fail loudly
   211	  // so the user notices they asked to resume at a phase that was excluded
   212	  // (e.g. smart-phase selection dropped "refactor", or the caller passed
   213	  // an explicit phases array that doesn't include resumeFrom).
   214	  if (options.resumeFrom && !phases.includes(options.resumeFrom)) {
   215	    throw new Error(
   216	      `resumeFrom="${options.resumeFrom}" is not in the selected phases [${phases.join(", ")}]. ` +
   217	        `Include it explicitly in options.phases or remove resumeFrom.`,
   218	    );
   219	  }
   220	
   221	  const budgetPerPhase = options.budget ? options.budget / phases.length : 1.0;
