   580	// All task types get tools — the model decides whether to use them.
   581	// Previously conversation/explanation/analysis were excluded, but this
   582	// caused the model to print shell commands as text instead of calling tools
   583	// when the classifier miscategorized a request (e.g., "look at files on my desktop"
   584	// classified as "conversation"). A coding assistant should always have tools available.
   585	
   586	export async function* runAgentLoop(
   587	  messages: ConversationMessage[],
   588	  options: AgentLoopOptions,
   589	): AsyncGenerator<AgentEvent> {
   590	  const { router, costTracker, tools, config, sessionId } = options;
   591	  let { systemPrompt } = options;
   592	
   593	  // Establish the workspace context for this agent session. Tools like
   594	  // file_write, file_edit, file_read, glob, grep, shell, and git now resolve
   595	  // paths relative to options.projectPath instead of process.cwd().
   596	  //
   597	  // Uses enterWith() rather than withWorkspace() because this is a generator:
   598	  // we can't wrap yield statements in a callback, and enterWith() persists for
   599	  // the rest of the current async execution. Nested spawnSubagent calls can
   600	  // override this scope with their own withWorkspace.
   601	  enterWorkspace(options.projectPath);
   602	
   603	  // Initialize trajectory recorder — enabled by default for learning loop.
   604	  // Explicitly opt out with trajectoryEnabled: false.
   605	  const sessionStartTime = Date.now();
   606	  const trajectoryEnabled = options.trajectoryEnabled !== false;
   607	  const trajectory = trajectoryEnabled
   608	    ? new TrajectoryRecorder(sessionId)
   609	    : null;
   610	  trajectory?.recordSessionStart({
   611	    projectPath: options.projectPath,
   612	    systemPrompt: systemPrompt.slice(0, 200),
   613	  });
   614	
   615	  // Reset task state and wire event handlers for this invocation
   616	  clearTasks();
   617	  const taskEventQueue: AgentEvent[] = [];
   618	  const TASK_QUEUE_CAP = 1000; // Prevent OOM from unbounded push — Forge R06
   619	  setTaskEventHandler((type, task) => {
   620	    if (taskEventQueue.length < TASK_QUEUE_CAP) {
   621	      taskEventQueue.push({ type, task } as AgentEvent);
   622	    }
   623	  });
   624	
   625	  // Wire background task completion events into the same queue
   626	  setBackgroundEventHandler((event) => {
   627	    if (taskEventQueue.length >= TASK_QUEUE_CAP) return;
   628	    taskEventQueue.push({
   629	      type: "background-complete",
   630	      taskId: event.taskId,
   631	      command: event.command,
   632	      exitCode: event.exitCode,
   633	      stdout: event.stdout,
   634	      stderr: event.stderr,
   635	    } as AgentEvent);
   636	  });
   637	
   638	  // Wire tool output streaming into the same queue
   639	  setToolOutputHandler((event) => {
   640	    if (taskEventQueue.length >= TASK_QUEUE_CAP) return;
   641	    taskEventQueue.push({
   642	      type: "tool-output-partial",
   643	      toolName: event.toolName,
   644	      chunk: event.chunk,
   645	    } as AgentEvent);
   646	  });
   647	
   648	  // Middleware metadata — hoisted so the tool wrapper closure can access it
   649	  // for trust propagation (syncTrustWindow/flushTrustWindow).
   650	  const mwMetadata: Record<string, unknown> = {};
   651	
   652	  // Run middleware beforeAgent hook (if pipeline provided).
   653	  //
   654	  // This runs BEFORE the classified try/catch at line ~785, so a
   655	  // throwing middleware would historically escape the entire error
   656	  // classifier and surface as an unhandled exception in the generator.
   657	  // Codex flagged this as MAJOR on the v15 P9d-2 chaos suite. Wrap
   658	  // the call in its own typed-error scope so a "blocked by X"
   659	  // middleware still emits a category=middleware event consumers can
   660	  // route on.
   661	  if (options.middleware) {
   662	    const mwState = {
   663	      turn: 0,
   664	      messages: messages.map((m) => ({ role: m.role, content: m.content })),
   665	      systemPrompt,
   666	      toolNames: [],
   667	      metadata: mwMetadata,
   668	    };
   669	    try {
   670	      const mwResult = options.middleware.runBeforeAgent(mwState);
   671	      if (mwResult.systemPrompt !== systemPrompt) {
   672	        systemPrompt = mwResult.systemPrompt;
   673	      }
   674	    } catch (mwErr: any) {
   675	      // Surface tagged-middleware throws as the same typed event as
   676	      // mid-stream middleware failures. Use the tagged `.middleware`
   677	      // field if present; otherwise label as the generic
   678	      // "beforeAgent" middleware so the operator knows where to look.
   679	      const tag = mwErr?.middleware ?? "beforeAgent";
   680	      const reason = mwErr?.reason ?? mwErr?.message ?? "unknown reason";
   681	      yield {
   682	        type: "error",
   683	        error: new Error(`Blocked by ${tag}: ${reason}`),
   684	        category: "middleware",
   685	      };
   686	      return;
   687	    }
   688	  }
   689	
   690	  // Phase: classifying
   691	  yield { type: "thinking" as const, phase: "classifying" as const };
   692	  const lastUserMsg = [...messages].reverse().find((m) => m.role === "user");
