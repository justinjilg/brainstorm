   353	            )
   354	          : { passed: true, output: "" };
   355	
   356	        result = {
   357	          phase,
   358	          agentId: config.agentId,
   359	          output: `Build: ${buildResult.passed ? "PASS" : "FAIL"}\nTests: ${testResult.passed ? "PASS" : "FAIL"}\n${buildResult.output}\n${testResult.output}`,
   360	          cost: 0,
   361	          toolCalls: [],
   362	          duration: Date.now() - startTime,
   363	          success: buildResult.passed && testResult.passed,
   364	        };
   365	
   366	        if (!result.success) {
   367	          yield record({
   368	            type: "feedback-loop",
   369	            from: "verify",
   370	            to: "implementation",
   371	            reason: "Build or tests failed",
   372	          });
   373	        }
   374	      } else {
   375	        // Standard single-agent phase
   376	        const agentResult = await dispatcher.runPhase(
   377	          config.agentId,
   378	          config.subagentType,
   379	          prompt,
   380	          { budget: budgetPerPhase, projectPath: options.projectPath },
   381	        );
   382	
   383	        // An empty/whitespace-only phase output is a failure, not a silent
   384	        // success — otherwise a step-capped or reasoning-only agent turn
   385	        // produces a "successful" phase with no artifact for downstream
   386	        // phases to build on. (Mirrors the workflow engine's artifact check.)
   387	        const phaseText = agentResult.text ?? "";
   388	        const phaseEmpty = phaseText.trim().length === 0;
   389	        result = {
   390	          phase,
   391	          agentId: config.agentId,
   392	          output: phaseText,
   393	          cost: agentResult.cost,
   394	          toolCalls: agentResult.toolCalls,
   395	          duration: Date.now() - startTime,
   396	          success: !phaseEmpty,
   397	          ...(phaseEmpty
   398	            ? { error: `Phase "${phase}" produced an empty output` }
   399	            : {}),
   400	        };
   401	      }
   402	
   403	      // Capture outputs for downstream phases
   404	      if (phase === "spec") specOutput = result.output;
   405	      if (phase === "architecture") designOutput = result.output;
   406	      if (phase === "implementation") implementationOutput = result.output;
   407	
   408	      totalCost += result.cost;
   409	      results.push(result);
   410	      yield record({ type: "phase-completed", result });
   411	    } catch (err) {
   412	      const error = err instanceof Error ? err.message : String(err);
   413	      yield record({ type: "phase-failed", phase, error });
   414	      results.push({
   415	        phase,
   416	        agentId: config.agentId,
   417	        output: "",
   418	        cost: 0,
   419	        toolCalls: [],
   420	        duration: Date.now() - startTime,
   421	        success: false,
   422	        error,
   423	      });
   424	    }
   425	  }
   426	
   427	  // Post-loop terminal. Skipped entirely if the loop already terminated
   428	  // (budget pause emitted its terminal + finalized). Otherwise emit exactly
   429	  // ONE of completed/failed based on whether any phase failed, and finalize
   430	  // exactly once — never both a pause and a completed for one run.
   431	  if (!terminated) {
   432	    const failedPhases = results
   433	      .filter((r) => !r.success)
   434	      .map((r) => r.phase);
   435	    if (failedPhases.length > 0) {
   436	      yield record({
   437	        type: "pipeline-failed",
   438	        results,
   439	        totalCost,
   440	        failedPhases,
   441	      });
   442	    } else {
   443	      yield record({ type: "pipeline-completed", results, totalCost });
   444	    }
   445	
   446	    // Finalize trajectory — persists to disk as training data for BrainstormLLM v2
   447	    const trajectory = recorder.finalize();
   448	    if (trajectory.phases.length > 0) {
   449	      console.error(
   450	        `[trajectory] ${trajectory.id} — ${trajectory.phases.length} phases, $${trajectory.totalCost.toFixed(4)}, ${trajectory.totalDuration}ms`,
   451	      );
   452	    }
   453	  }
   454	}
   455	
   456	// ── Helpers ─────────────────────────────────────────────────────────
   457	
   458	function buildPhasePrompt(
   459	  phase: PipelinePhase,
   460	  request: string,
   461	  context: { spec: string; design: string; implementation: string },
   462	  memoryContext?: string,
   463	): string {
   464	  // Prepend project memory so subagents have expertise context
   465	  const prefix = memoryContext
   466	    ? `## Project Context (from memory)\n\n${memoryContext}\n\n---\n\n`
   467	    : "";
   468	  switch (phase) {
   469	    case "spec":
   470	      return `${prefix}Write a specification for the following request:\n\n${request}`;
   471	    case "architecture":
   472	      return `${prefix}Design the technical implementation for this specification:\n\n${context.spec || request}`;
   473	    case "implementation":
   474	      return `${prefix}Implement the following design:\n\n${context.design || context.spec || request}`;
   475	    case "review":
   476	      return `${prefix}Review the code changes made for this task. Check for bugs, security issues, and style.\n\nOriginal request: ${request}\n\nSpec: ${context.spec?.slice(0, 500) || "N/A"}`;
   477	    case "verify":
   478	      return `Verify the build and tests pass.`;
   479	    case "refactor":
   480	      return `${prefix}Review the recently implemented code and suggest refactoring improvements without changing behavior.`;
   481	    case "deploy":
   482	      return `Deploy the changes. Verify build first, then run deployment commands.`;
   483	    case "document":
   484	      return `${prefix}Generate documentation for the changes made.\n\nSpec: ${context.spec?.slice(0, 500) || "N/A"}\nDesign: ${context.design?.slice(0, 500) || "N/A"}`;
   485	    case "report":
   486	      return `Produce an execution report summarizing what was accomplished, costs, findings, and next steps.\n\nOriginal request: ${request}`;
   487	    default:
   488	      return request;
   489	  }
   490	}

