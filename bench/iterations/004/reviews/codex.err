   897	      `data: ${JSON.stringify({ type: "session", sessionId: session.id, conversationId })}\n\n`,
   898	    );
   899	
   900	    const messages = [{ role: "user" as const, content: body.message }];
   901	
   902	    // Abort the agent loop if the SSE client disconnects. Without this, a
   903	    // client that opens /chat/stream and drops the socket lets the server
   904	    // keep pulling tokens from the LLM — billable work with no reader,
   905	    // trivial cost-exhaustion vector for any connecting client.
   906	    const abortController = new AbortController();
   907	    const onClose = () => abortController.abort();
   908	    req.on("close", onClose);
   909	
   910	    try {
   911	      for await (const event of runAgentLoop(messages, {
   912	        config: this.deps.config,
