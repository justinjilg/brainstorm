   468	// ── Helpers ─────────────────────────────────────────────────────────
   469	
   470	function buildPhasePrompt(
   471	  phase: PipelinePhase,
   472	  request: string,
   473	  context: { spec: string; design: string; implementation: string },
   474	  memoryContext?: string,
   475	): string {
   476	  // Prepend project memory so subagents have expertise context
   477	  const prefix = memoryContext
   478	    ? `## Project Context (from memory)\n\n${memoryContext}\n\n---\n\n`
   479	    : "";
   480	  switch (phase) {
   200	export interface AgentTask {
   201	  id: string;
   202	  description: string;
   203	  status: TaskStatus;
   204	  createdAt: number;
   205	  updatedAt: number;
   206	}
   207	
   208	// ── Execution Outcome Contract ───────────────────────────────────────
   209	// One aggregate RunOutcome composed of one or more ModelAttemptOutcomes, with
   210	// explicit termination, recovery, artifacts, checks, and cost. Two levels
   211	// because a single logical run can span multiple model attempts (fallback:
   212	// model A fails empty → model B succeeds): routing (Thompson/quarantine) needs
   213	// per-attempt evidence, while surfaces (workflow/pipeline/UI/trajectory) need
   214	// one aggregate. A flat outcome would erase model A's failure.
   215	
   216	/** Why a single model attempt (or the aggregate run) stopped producing. */
   217	export type StopCause =
   218	  | "natural_stop" // model finished on its own
   219	  | "step_cap_reached" // hit the max-steps budget mid-work
   220	  | "empty_output" // produced no usable text
   221	  | "truncated_tool_call" // stream ended mid tool-call assembly
   222	  | "output_limit" // provider length / max_tokens
   223	  | "content_filtered" // provider content filter
   224	  | "error" // threw
   225	  | "budget_exhausted" // cost ceiling
   226	  | "fallback_exhausted" // all fallback models tried, none succeeded
   227	  | "aborted"; // cancelled by signal
   228	
   229	/**
   230	 * Tri-state gate result. `not_run` (gate was skipped) and `unknown` (gate ran
   231	 * but couldn't decide) are distinct from `failed` — an optional boolean can't
   232	 * express that. Security especially: BLOCKING a dangerous action means the
   233	 * security CONTROL succeeded while the requested execution failed; a single
   234	 * `false` conflates the two.
   235	 */
   236	export type CheckStatus = "passed" | "failed" | "not_run" | "unknown";
   237	
   238	/** Outcome of one model attempt within a run. Feeds routing learning. */
   239	export interface ModelAttemptOutcome {
   240	  modelId: string;
   241	  taskType: TaskType;
   242	  status: "succeeded" | "failed" | "aborted";
   243	  stopCause: StopCause;
   244	  /** Raw provider finish_reason, when available (diagnostics). */
   245	  providerFinishReason?: string;
   246	  latencyMs: number;
   247	  costUsd: number;
   248	}
   249	
   250	/** Aggregate outcome of a logical run. Feeds surfaces + momentum + trajectory. */
   251	export interface RunOutcome {
   252	  status: "succeeded" | "failed" | "partial" | "aborted";
   253	  /** Every model attempt this run made, in order. At least one. */
   254	  attempts: ModelAttemptOutcome[];
   255	  /** The model whose output the run ultimately used (if it succeeded). */
   256	  finalModelId?: string;
   257	  /** How the FIRST attempt terminated — preserved even after recovery, so a
   258	   *  step-capped-then-synthesized run doesn't masquerade as a clean stop. */
   259	  initialStopCause: StopCause;
   260	  /** How the run recovered from a non-clean initial stop, if it did. */
   261	  recovery?:
   262	    | "fallback"
   263	    | "forced_synthesis"
   264	    | "tool_nudge"
   265	    | "verification_retry";
   266	  /** Did the run produce usable final text? (distinct from making changes) */
   267	  hasFinalResponse: boolean;
   268	  /** Artifact references produced (files written, etc.), if tracked. */
   269	  producedArtifacts?: string[];
   270	  /** Did the run mutate the workspace? (a coder can edit files yet emit no
   271	   *  final text — it made changes but still needs synthesis) */
   272	  madeChanges?: boolean;
   273	  verification: CheckStatus;
   274	  security: CheckStatus;
   275	  judge: CheckStatus;
   276	  costUsd: number;
   277	}
   278	
   279	export type AgentEvent =
   280	  | {
   281	      type: "thinking";
   282	      phase: "classifying" | "routing" | "connecting" | "streaming";
   283	    }
   284	  | { type: "routing"; decision: RoutingDecision }
   285	  | { type: "text-delta"; delta: string }
   286	  | { type: "tool-call-start"; toolName: string; args: unknown }
   287	  | { type: "tool-call-result"; toolName: string; result: unknown }
   288	  | { type: "step-complete"; text: string; toolCalls: unknown[] }
   289	  | { type: "gateway-feedback"; feedback: GatewayFeedbackData }
   290	  | {
   291	      type: "compaction";
   292	      removed: number;
   293	      tokensBefore: number;
   294	      tokensAfter: number;
   295	    }
   296	  | { type: "tool-output-partial"; toolName: string; chunk: string }
   297	  | { type: "task-created"; task: AgentTask }
   298	  | { type: "task-updated"; task: AgentTask }
   299	  | {
   300	      type: "subagent-result";
   301	      subagentType: string;
   302	      model: string;
   303	      cost: number;
   304	      toolCalls: string[];
   305	    }
   306	  | { type: "reasoning"; content: string }
   307	  | {
   308	      type: "background-complete";
   309	      taskId: string;
   310	      command: string;
   311	      exitCode: number;
   312	      stdout: string;
   313	      stderr: string;
   314	    }
   315	  | { type: "model-retry"; fromModel: string; toModel: string; reason: string }
   316	  | { type: "fallback-exhausted"; modelsTried: string[]; reason: string }
   317	  | { type: "budget-warning"; used: number; limit: number; remaining: number }
   318	  | { type: "empty-response"; modelId: string }
   319	  | { type: "context-budget"; used: number; limit: number; percent: number }
   320	  | { type: "loop-warning"; message: string }
   321	  | {
   322	      type: "verify-passed";
   323	      iteration: number;
   324	      mode: "typecheck" | "full";
   325	    }
   326	  | {
   327	      type: "verify-failed";
   328	      iteration: number;
   329	      maxIterations: number;
   330	      diagnostics: string;
   331	    }
   332	  | {
   333	      type: "tool-nudge";
   334	      iteration: number;
   335	      maxNudges: number;
   336	    }
   337	  | {
   338	      type: "daemon-tick";
   339	      tickNumber: number;
   340	      idleSeconds: number;
   341	      cost: number;
   342	    }
   343	  | { type: "daemon-sleep"; sleepMs: number; reason: string }
   344	  | { type: "daemon-wake"; trigger: "timer" | "user" | "scheduler" }
   345	  | { type: "daemon-stopped"; tickCount: number; totalCost: number }
   346	  | { type: "interrupted" }
   347	  | {
   348	      type: "error";
   349	      error: Error;
   350	      category?: "model-api" | "database" | "middleware" | "unknown";
   351	    }
   352	  | {
   353	      type: "done";
   354	      totalCost: number;
   355	      totalTokens?: { input: number; output: number };
   356	      /** The canonical run outcome. Additive: existing consumers keep reading
   357	       *  totalCost/totalTokens while surfaces migrate to `outcome`. */
   358	      outcome?: RunOutcome;
   359	    };
   360	
   361	// ── Turn Context ─────────────────────────────────────────────────────
   362	
   363	/** Per-turn state injected between turns so the agent knows what just happened. */
   364	export interface TurnContext {
   365	  turn: number;
   366	  model: string;
   367	  strategy: string;
   368	  toolCalls: Array<{ name: string; ok: boolean }>;
   369	  turnCost: number;
   370	  budgetRemaining: number;
   371	  budgetPercent: number;
   372	  filesRead: string[];
   373	  filesWritten: string[];
   374	  sessionMinutes: number;
   375	  unhealthyTools: Array<{ name: string; error: string }>;
   376	  buildStatus: "passing" | "failing" | "unknown";
   377	  buildWarning: string;
   378	  costPerHour: number;
   379	}
   380	
   381	/** Format TurnContext as a compact one-line summary for system message injection. */
   382	export function formatTurnContext(ctx: TurnContext): string {
   383	  const tools =
   384	    ctx.toolCalls.length > 0
   385	      ? ctx.toolCalls.map((t) => `${t.name}${t.ok ? "" : "✗"}`).join(" ")

