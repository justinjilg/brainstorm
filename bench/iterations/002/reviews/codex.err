    41	 * bare argument fragments are re-pointed at the most recently started call,
    42	 * whatever index the server claimed.
    43	 */
    44	export function createToolCallIdNormalizingFetch(
    45	  baseFetch: typeof globalThis.fetch = globalThis.fetch,
    46	): typeof globalThis.fetch {
    47	  return async (input, init) => {
    48	    const response = await baseFetch(input, init);
    49	    const contentType = response.headers.get("content-type") ?? "";
    50	    if (!response.body || !contentType.includes("text/event-stream")) {
    51	      return response;
    52	    }
    53	
    54	    // Per-choice stream state: the normalized index of the currently open
    55	    // call (-1 = none yet) and a counter for synthesized ids.
    56	    const openCall = new Map<number, number>();
    57	    let synthCounter = 0;
    58	    const decoder = new TextDecoder();
    59	    const encoder = new TextEncoder();
    60	    let buffer = "";
    61	
    62	    const normalizeLine = (line: string): string => {
    63	      if (!line.startsWith("data:")) return line;
    64	      const payload = line.slice(5).trim();
    65	      if (!payload || payload === "[DONE]") return line;
    66	      try {
    67	        const json = JSON.parse(payload);
    68	        let changed = false;
    69	        for (const choice of json?.choices ?? []) {
    70	          const choiceIdx = typeof choice?.index === "number" ? choice.index : 0;
    71	          for (const tc of choice?.delta?.tool_calls ?? []) {
    72	            if (typeof tc?.index !== "number") continue;
    73	            const isCallStart =
    74	              typeof tc?.function?.name === "string" ||
    75	              (typeof tc.id === "string" && tc.id.length > 0);
    76	            if (isCallStart) {
    77	              const normIndex = (openCall.get(choiceIdx) ?? -1) + 1;
    78	              openCall.set(choiceIdx, normIndex);
    79	              if (tc.index !== normIndex) {
    80	                tc.index = normIndex;
    81	                changed = true;
    82	              }
    83	              if (typeof tc.id !== "string" || tc.id.length === 0) {
    84	                tc.id = `call_norm_${synthCounter++}`;
    85	                changed = true;
    86	              }
    87	            } else {
    88	              const current = openCall.get(choiceIdx);
    89	              if (current === undefined) continue; // fragment before any call — leave untouched
    90	              if (tc.index !== current) {
    91	                tc.index = current;
    92	                changed = true;
    93	              }
    94	              if ("id" in tc && tc.id == null) {
    95	                delete tc.id;
    96	                changed = true;
    97	              }
    98	            }
    99	          }
   100	        }
   101	        return changed ? `data: ${JSON.stringify(json)}` : line;
   102	      } catch {
   103	        // Non-JSON data line — pass through untouched.
   104	        return line;
   105	      }
   106	    };
   107	
   108	    const transform = new TransformStream<Uint8Array, Uint8Array>({
   109	      transform(chunk, controller) {
   110	        buffer += decoder.decode(chunk, { stream: true });
   111	        const lines = buffer.split("\n");
   112	        buffer = lines.pop() ?? "";
   113	        for (const line of lines) {
   114	          controller.enqueue(encoder.encode(normalizeLine(line) + "\n"));
   115	        }
   116	      },
   117	      flush(controller) {
   118	        if (buffer) controller.enqueue(encoder.encode(normalizeLine(buffer)));
   119	      },
   120	    });
   121	
   122	    return new Response(response.body.pipeThrough(transform), {
   123	      status: response.status,
   124	      statusText: response.statusText,
   125	      headers: response.headers,
   126	    });
   127	  };
   128	}
