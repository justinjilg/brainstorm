      for (const [modelId, entry] of Object.entries(freshScores)) {
        const model = allModels.find((m) => m.id === modelId);
        if (model) {
          model.capabilities.capabilityScores = entry.scores;
        }
      }
      registry.models = allModels;
    },
  };

  return registry;
}

