   145	
   146	export function inferModelLimits(raw: RawModelEntry): {
   147	  limits: InferredModelLimits;
   148	  source: "server" | "heuristic" | "default";
   149	} {
   150	  const family =
   151	    MODEL_FAMILY_LIMITS.find((f) => f.match.test(raw.id))?.limits ?? null;
   152	  const serverContext =
   153	    typeof raw.context_length === "number"
   154	      ? raw.context_length
   155	      : typeof raw.max_model_len === "number"
   156	        ? raw.max_model_len
   157	        : null;
   158	
   159	  // Server-reported context wins; family heuristic fills the rest.
   160	  const base = family ?? DEFAULT_INFERRED_LIMITS;
   161	  if (serverContext && serverContext > 0) {
   162	    return {
   163	      limits: {
   164	        ...base,
   165	        contextWindow: serverContext,
   166	        maxOutputTokens: Math.min(base.maxOutputTokens, serverContext),
   167	      },
   168	      source: "server",
   169	    };
   170	  }
   171	  return { limits: base, source: family ? "heuristic" : "default" };
   172	}
