   142	/** Raw /v1/models entry — servers vary in what limit metadata they expose. */
   143	interface RawModelEntry {
   144	  id: string;
   145	  /** LM Studio / OpenRouter convention. */
   146	  context_length?: number;
   147	  /** vLLM convention. */
   148	  max_model_len?: number;
   149	}
   150	
   151	export function inferModelLimits(raw: RawModelEntry): {
   152	  limits: InferredModelLimits;
   153	  source: "server" | "heuristic" | "default";
   154	} {
   155	  const family =
   156	    MODEL_FAMILY_LIMITS.find((f) => f.match.test(raw.id))?.limits ?? null;
   157	  const serverContext =
   158	    typeof raw.context_length === "number"
   159	      ? raw.context_length
   160	      : typeof raw.max_model_len === "number"
   161	        ? raw.max_model_len
   162	        : null;
   163	
   164	  // Server-reported context wins; family heuristic fills the rest.
   165	  const base = family ?? DEFAULT_INFERRED_LIMITS;
   166	  if (serverContext && serverContext > 0) {
   167	    return {
   168	      limits: {
   169	        ...base,
   170	        contextWindow: serverContext,
   171	        maxOutputTokens: Math.min(base.maxOutputTokens, serverContext),
   172	      },
   173	      source: "server",
   174	    };
   175	  }
   176	  return { limits: base, source: family ? "heuristic" : "default" };
   177	}
