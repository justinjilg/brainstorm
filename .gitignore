# Generated artifacts
docs/internal/sbom.json

# Contract preflight result artifact — written on every run so CI
# failures leave diagnostic JSON on disk. Regenerable via
# `npm run contract-check`.
.contract-check/

# Contract compiler output — regenerable via
# `pnpm --filter @brainst0rm/godmode run compile-contract -- --write`.
# Kept out of git so the source-of-truth (packages/godmode/src/contract/
# schemas.ts) is the obvious place to edit. Snapshot tests in
# packages/godmode/src/contract/__tests__/ catch unintended drift.
generated/platform-contract/

# Marketing site (separate project, lives elsewhere)
apps/web/

# Desktop app build artifacts (source is tracked)
apps/desktop/dist/
apps/desktop/node_modules/
apps/desktop/src-tauri/target/
apps/desktop/release/
apps/desktop/test-results/

# Monorepo-wide test / build ephemera
test-results/
tmp/

# tsup occasionally leaves bundled_*.mjs scratch files in package
# roots when a build is interrupted. Never meant to be committed.
**/tsup.config.bundled_*.mjs

# Runtime vault (Obsidian-style personal knowledge store; user-local).
brainstorm-vault/
