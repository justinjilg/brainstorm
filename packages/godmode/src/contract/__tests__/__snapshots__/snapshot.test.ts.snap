          "version",
          "product",
        ],
        "type": "object",
      },
      "summary": "Liveness + identity probe. Always available, no auth. Returns 200 for healthy/degraded, 503 for unhealthy.",
    },
    "platform-events": {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/platform/events",
      "request": {
        "additionalProperties": false,
        "description": "Platform event envelope. Posted to /api/v1/platform/events; receiver MUST verify the signature.",
        "properties": {
          "correlation_id": {
            "format": "uuid",
            "type": "string",
          },
          "data": {
            "additionalProperties": {},
            "description": "Event-specific payload.",
            "type": "object",
          },
          "id": {
            "description": "UUIDv7 event identifier.",
            "type": "string",
          },
          "product": {
            "type": "string",
          },
          "schema_version": {
            "exclusiveMinimum": 0,
            "type": "integer",
          },
          "signature": {
            "description": "HMAC-SHA256 of canonical JSON (event minus signature field) signed with the per-tenant derived key.",
            "type": "string",
          },
