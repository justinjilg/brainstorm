          "handled",
        ],
        "type": "object",
      },
      "summary": "Inbound platform event endpoint. Receiver MUST verify the HMAC signature against the per-tenant derived key before processing.",
    },
    "platform-tenants": {
      "auth": "bearer",
      "method": "POST",
      "path": "/api/v1/platform/tenants",
      "request": {
        "additionalProperties": false,
