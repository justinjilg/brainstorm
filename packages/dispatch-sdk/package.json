{
  "name": "@brainst0rm/dispatch-sdk",
  "version": "0.14.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinjilg/brainstorm.git",
    "directory": "packages/dispatch-sdk"
  },
  "type": "module",
  "description": "Programmatic Brainstorm dispatch primitive for autonomous-agent operators (P1.7). Wraps the operator-side WebSocket flow with an async-iterator API for progress events and a typed dispatch() function.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@brainst0rm/relay": "workspace:*",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
