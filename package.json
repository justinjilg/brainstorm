{
  "name": "brainstorm",
  "private": true,
  "description": "Governed control plane for AI-managed infrastructure. Connect AI operators to your product ecosystem through a standardized protocol.",
  "keywords": [
    "ai",
    "cli",
    "llm",
    "mcp",
    "agent",
    "routing",
    "infrastructure",
    "control-plane",
    "ai-ops",
    "model-context-protocol",
    "thompson-sampling"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justinjilg/brainstorm.git"
  },
  "homepage": "https://brainstorm.co",
  "author": "Justin Jilg <jj@brainstorm.co>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build && npm run contract-check",
    "build:dangerous-skip-gates": "node -e \"console.error('[dangerous] Skipping Brainstorm preflight/contract gates; use npm run build for release/CI.')\" && turbo run build",
    "br:contract-map": "node scripts/br-business-contract-map.mjs",
    "br:contract-map:check": "node scripts/br-business-contract-map.mjs --check",
    "br:a2a-registry": "tsx tests/business-harness/a2a-registry-smoke.ts",
    "br:live-discovery": "tsx tests/business-harness/live-br-discovery.ts",
    "br:provider-envelope": "tsx tests/business-harness/provider-envelope-smoke.ts",
    "business:posture-trace": "tsx tests/business-harness/business-posture-trace.ts",
    "contract-check": "node scripts/contract-check.mjs",
    "contract-check:json": "node scripts/contract-check.mjs --json",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:abort-signal": "node scripts/lint-abort-signal-timeout.mjs",
    "test": "turbo run test",
    "test:dogfood": "npx tsx tests/dogfood/run-dogfood.ts",
    "test:product-platform": "tsx tests/business-harness/product-platform-smoke.ts",
    "test:workflow": "npx tsx tests/workflow-demo/run-demo.ts",
    "typecheck": "turbo run typecheck",
    "postinstall": "npm rebuild better-sqlite3",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "sbom": "node scripts/generate-sbom.mjs",
    "setup:tooling": "node scripts/setup-tooling.mjs",
    "setup:tooling:dry": "node scripts/setup-tooling.mjs --dry-run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "dependency-cruiser": "17.3.10",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "turbo": "^2.9.14",
    "typescript": "^5.7",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "packages/tools/src/builtin/**/*.ts": [
      "scripts/precommit-regen-catalog.sh"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "dompurify": ">=3.4.0",
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.2",
    "hono": "4.12.21",
    "ip-address": "10.2.0",
    "mermaid": "11.15.0",
    "minimatch@10": {
      "brace-expansion": "5.0.6"
    },
    "postcss": "8.5.15",
    "uuid": "11.1.1",
    "ws": "8.20.1"
  }
}
